#!/usr/bin/env expect

# Validate a real completed Kubernetes/Kata Pod without re-running the workload.
# Usage: run-kata-k8s-pod-smoke.exp HOST POD RUNTIME_CLASS EXPECTED_OUTPUT LOG

if {$argc != 5} {
    puts stderr "usage: $argv0 HOST POD RUNTIME_CLASS EXPECTED_OUTPUT LOG"
    exit 2
}

lassign $argv host pod runtime_class expected_output log_path
foreach value [list $host $pod $runtime_class] {
    if {![regexp {^[A-Za-z0-9._-]+$} $value]} {
        puts stderr "unsafe host, Pod, or RuntimeClass argument"
        exit 2
    }
}

set timeout 20
log_file -noappend $log_path

proc run_remote {host args} {
    spawn -noecho ssh -o BatchMode=yes -o ConnectTimeout=8 -- $host \
        sudo -A kubectl --kubeconfig /etc/kubernetes/admin.conf {*}$args
    set output ""
    expect {
        -re {\n} {
            append output $expect_out(buffer)
            exp_continue
        }
        eof {
            append output $expect_out(buffer)
        }
        timeout {
            puts stderr "runtime-fail: kubectl timed out"
            close
            wait
            exit 124
        }
    }
    set child_status [wait]
    if {[lindex $child_status 2] != 0 || [lindex $child_status 3] != 0} {
        puts stderr "runtime-fail: kubectl exited with $child_status"
        exit 1
    }
    return $output
}

set status [run_remote $host get pod $pod \
    -o=jsonpath={.spec.runtimeClassName},{.status.phase},{.status.containerStatuses\[0\].state.terminated.exitCode}]
set status [string trim $status]
if {![string equal $status "${runtime_class},Succeeded,0"]} {
    puts stderr "runtime-fail: Kata Pod runtime class, phase, or exit code mismatch; status=$status; raw=$log_path"
    exit 1
}

set output [run_remote $host logs $pod]
if {![string equal [string trim $output] $expected_output]} {
    puts stderr "runtime-fail: Kata Pod output mismatch; raw=$log_path"
    exit 1
}

puts "runtime-pass: Kata Pod $pod used $runtime_class, completed with exit 0, and matched expected output; raw=$log_path"
